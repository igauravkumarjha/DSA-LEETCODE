#include <iostream>
int main() {
    int n;
    std::cin >> n;
    for(int i=1;i<=n;i++){
        for(int j=1;j<=n;j++){
            std::cout<<"_";
        }
        for(int k=1;k<=i;k++){
            std::cout<<k;
        }
        for(int p=i-1;p>=1;p--){
            std::cout<<p;
        }
        std::cout << std::endl;
    }
    return 0;
}
